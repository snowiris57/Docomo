<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 準備 -->
        <TextView style="@style/Section" android:text="準備" />

        <TextView
            android:id="@+id/tvShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku の権限を許可" />

        <Button
            android:id="@+id/btnPerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知・電話状態の権限を許可" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="電池の最適化から除外" />

        <!-- 監視 -->
        <TextView style="@style/Section" android:text="監視" />

        <Switch
            android:id="@+id/swMonitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="自動再接続を有効にする"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp"
            android:paddingVertical="8dp" />

        <Button
            android:id="@+id/btnReconnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="今すぐ再接続" />

        <!-- 設定 -->
        <TextView style="@style/Section" android:text="設定" />

        <TextView style="@style/Label" android:text="チェック間隔（秒）" />
        <EditText android:id="@+id/etInterval" style="@style/Num" />

        <TextView style="@style/Label" android:text="連続で何回異常なら再接続するか" />
        <EditText android:id="@+id/etFail" style="@style/Num" />

        <CheckBox
            android:id="@+id/cbSignal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="疎通OKでも電波が弱ければ再接続する" />

        <TextView style="@style/Label" android:text="電波弱とみなす RSRP（dBm、例 -120）" />
        <EditText
            android:id="@+id/etRsrp"
            style="@style/Num"
            android:inputType="numberSigned" />

        <TextView style="@style/Label" android:text="再接続後の待ち時間（秒）※失敗が続くと倍々で延長" />
        <EditText android:id="@+id/etCooldown" style="@style/Num" />

        <TextView style="@style/Label" android:text="1時間あたりの再接続上限（回）" />
        <EditText android:id="@+id/etMaxHour" style="@style/Num" />

        <CheckBox
            android:id="@+id/cbAirplane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="データOFF/ONで直らなければ機内モードON/OFFも試す" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="設定を保存" />

        <!-- ログ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Section"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="ログ" />

            <Button
                android:id="@+id/btnClearLog"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消去" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
